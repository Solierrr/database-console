{
  "version": 2,
  "comment": "Contrato de acesso direto aos bancos, por consumidor. Cada papel (grupo, sem login) recebe privilegios por banco (core = coredb, auth = authdb) e por schema. Papeis de leitura enxergam apenas o schema export (views); nada em public. Tabelas com \"*\" liberam todas as colunas; uma lista libera so aquelas colunas. Quem adiciona uma view ou coluna ao export atualiza este arquivo e roda `python scripts/roles.py apply`.",
  "consumers": {
    "database-bootstrap": {
      "role": "ro_bootstrap",
      "description": "Job que extrai o coredb e monta o grafo Neo4j.",
      "grants": {
        "core": {
          "schema": "export",
          "privileges": [
            "SELECT"
          ],
          "tables": {
            "brand": "*",
            "certification": "*",
            "company": "*",
            "geolocation": "*",
            "inventory": "*",
            "local_unit": "*",
            "model": "*",
            "offer": "*",
            "person": [
              "id",
              "user_id"
            ],
            "profession": "*",
            "professional_registration": "*",
            "professional_review": "*",
            "proposal": "*",
            "proposal_item": "*",
            "service_executor": "*",
            "shift": "*",
            "subscription": "*",
            "supplier": "*",
            "technical_project": "*",
            "technical_service": "*",
            "technician": "*",
            "technician_affiliation": "*",
            "user_account": [
              "id",
              "is_active"
            ]
          }
        }
      }
    },
    "databricks-sync": {
      "role": "ro_databricks",
      "description": "Replicacao para o Databricks: todas as views do schema export do coredb e do authdb. Use um login por banco.",
      "grants": {
        "core": {
          "schema": "export",
          "privileges": [
            "SELECT"
          ],
          "all_tables": true
        },
        "auth": {
          "schema": "export",
          "privileges": [
            "SELECT"
          ],
          "all_tables": true
        }
      }
    },
    "database-rpa": {
      "role": "rpa_writer",
      "description": "Excecao documentada ao dono unico do coredb: ETL do database-rpa. Escreve direto nas tabelas que ja usa, so em QA.",
      "environments": [
        "qa"
      ],
      "grants": {
        "core": {
          "schema": "public",
          "privileges": [
            "SELECT",
            "INSERT",
            "UPDATE"
          ],
          "tables": {
            "address": "*",
            "brand": "*",
            "business_contact": "*",
            "certification": "*",
            "company": "*",
            "company_photo": "*",
            "company_plan": "*",
            "company_position": "*",
            "contact": "*",
            "inventory": "*",
            "job_position": "*",
            "local_unit": "*",
            "model": "*",
            "model_photo": "*",
            "offer": "*",
            "person": "*",
            "profession": "*",
            "professional_registration": "*",
            "requester": "*",
            "subscription": "*",
            "supplier": "*",
            "technical_project": "*",
            "technician": "*",
            "technician_affiliation": "*",
            "user_account": "*",
            "user_company": "*",
            "user_photo": "*"
          }
        }
      }
    }
  }
}
