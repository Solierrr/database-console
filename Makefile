# Makefile padrao dos repositorios Solierrr.
# Igual em todos os repos: so o bloco "especifico deste repositorio" muda.
# Requer: make e sh (Git Bash no Windows). Para `make vault`: Infisical CLI e `infisical login`.

# ---- especifico deste repositorio ----
VAULT_FOLDERS ?= /database
PY ?= python
INSTALL_CMD   ?= $(PY) -m pip install -r scripts/requirements.txt ruff
DEV_CMD       ?= sh scripts/dev-stack.sh up
BUILD_CMD     ?= $(PY) -m compileall -q scripts seed
TEST_CMD      ?= $(PY) -m unittest discover -s tests -v
LINT_CMD      ?= $(PY) -m ruff check --isolated --select E4,E7,E9,F scripts
FORMAT_CMD    ?=
CLEAN_PATHS   ?= .pytest_cache .ruff_cache .mypy_cache
DOCTOR_TOOLS  ?= git python psql

# ---- padrao (nao editar por repositorio) ----
INFISICAL_PROJECT_ID ?= 2296d19c-5f3b-41e1-afa3-fcde39966a71
ENV ?= local
OUT ?= .env
# Git Bash converteria '/vite' em 'C:/Program Files/Git/vite' ao chamar o CLI. A variavel vale so para o
# CLI: exporta-la para o make quebraria o mvnw, o gradlew e outras ferramentas que precisam da conversao.
ifeq ($(OS),Windows_NT)
INFISICAL ?= MSYS_NO_PATHCONV=1 infisical.cmd
else
INFISICAL ?= infisical
endif

.DEFAULT_GOAL := help
.PHONY: help verify-vault vault env dev install build test lint format clean doctor ci

help: ## Show the available commands
	@awk 'BEGIN {FS = ":.*## "; printf "Usage: make <target>\n\n"} /^[a-zA-Z0-9_-]+:.*## / {printf "  %-18s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

verify-vault: ## Check that the Infisical CLI is installed and authenticated
	@$(INFISICAL) --version >/dev/null 2>&1 || { echo "Infisical CLI not installed. Install it (https://infisical.com/docs/cli/overview) and retry."; exit 1; }
	@$(INFISICAL) user get token --silent >/dev/null 2>&1 || { echo "No active Infisical session. Run 'infisical login' and retry."; exit 1; }
	@echo "OK: Infisical authenticated."

vault: verify-vault ## Write OUT (default .env) from Infisical; ENV=local|qa|prod (default local)
	@case "$(ENV)" in local|qa|prod) ;; *) echo "Invalid ENV '$(ENV)'. Use local, qa or prod (example: make vault ENV=qa)."; exit 1;; esac
	@test -n "$(strip $(VAULT_FOLDERS))" || { echo "vault: VAULT_FOLDERS is not configured for this repository"; exit 1; }
	@tmp=$$(mktemp) || exit 1; \
	echo "# Generated by make vault - env=$(ENV) folders=$(VAULT_FOLDERS)" > "$$tmp"; \
	for folder in $(VAULT_FOLDERS); do \
		echo "Extracting $$folder (env=$(ENV))..."; \
		out=$$($(INFISICAL) export --env=$(ENV) --path=$$folder --format=dotenv --projectId=$(INFISICAL_PROJECT_ID) --silent 2>&1) \
			|| { echo "Failed to extract '$$folder' (env=$(ENV)). Check access, environment and path in Infisical."; rm -f "$$tmp"; exit 1; }; \
		if echo "$$out" | grep -q 'serving secrets from last successful fetch'; then \
			echo "Infisical could not reach the server for '$$folder' and returned cached data. $(OUT) was not changed."; rm -f "$$tmp"; exit 1; fi; \
		vars=$$(echo "$$out" | grep -E '^[[:space:]]*(export[[:space:]]+)?[^#[:space:]][^=]*='); \
		if [ -z "$$vars" ]; then \
			echo "No secrets returned for '$$folder' (env=$(ENV)). $(OUT) was not changed."; rm -f "$$tmp"; exit 1; fi; \
		printf '\n# --- %s ---\n%s\n' "$$folder" "$$vars" >> "$$tmp"; \
	done; \
	mv "$$tmp" "$(OUT)" && echo "OK: $(OUT) written (env=$(ENV))."

env: vault ## Alias for vault

dev: ## Start the dev server
	$(if $(strip $(DEV_CMD)),set -e; $(DEV_CMD),@echo "dev: not configured for this repository")

install: ## Install dependencies
	$(if $(strip $(INSTALL_CMD)),set -e; $(INSTALL_CMD),@echo "install: not configured for this repository")

build: ## Build the project
	$(if $(strip $(BUILD_CMD)),set -e; $(BUILD_CMD),@echo "build: not configured for this repository")

test: ## Run the tests
	$(if $(strip $(TEST_CMD)),set -e; $(TEST_CMD),@echo "test: not configured for this repository")

lint: ## Run the linter
	$(if $(strip $(LINT_CMD)),set -e; $(LINT_CMD),@echo "lint: not configured for this repository")

format: ## Format the code
	$(if $(strip $(FORMAT_CMD)),set -e; $(FORMAT_CMD),@echo "format: not configured for this repository")

clean: ## Remove build outputs (CLEAN_PATHS)
	$(if $(strip $(CLEAN_PATHS)),rm -rf $(CLEAN_PATHS),@echo "clean: not configured for this repository")

doctor: ## Check that the tools this repository needs are available
	@missing=0; \
	for tool in make $(DOCTOR_TOOLS); do \
		if command -v $$tool >/dev/null 2>&1; then echo "ok       $$tool"; else echo "MISSING  $$tool"; missing=1; fi; \
	done; \
	if $(INFISICAL) --version >/dev/null 2>&1; then \
		if $(INFISICAL) user get token --silent >/dev/null 2>&1; then echo "ok       infisical (logged in)"; else echo "WARN     infisical installed but not logged in (run 'infisical login')"; fi; \
	else echo "WARN     infisical not installed (only needed for 'make vault')"; fi; \
	exit $$missing

ci: lint test build ## Run lint, test and build in pipeline order

# ---- alvos deste repositorio ----
-include .env
ifeq ($(OS),Windows_NT)
POWERSHELL ?= powershell
else
POWERSHELL ?= pwsh
endif
.PHONY: dev-up dev-db dev-down dev-status dev-seed schema seed-plan dataload reset reset-mongo connect backup export-parquet roles-apply roles-check install-tools





TARGET ?= local
ENVIRONMENT ?= local
ROWS ?= 1000

ifneq ($(filter qa QA "qa" "QA",$(ENVIRONMENT)),)
	SUFIX = qa
else
	SUFIX =
endif

unquote = $(subst ",,$(1))
DB_NAME = $(call unquote,$(TARGET))db$(SUFIX)
# O .env do `make vault` traz DB_POSTGRES_*; o .env antigo trazia HOST, PORT, USER e PASSWORD.
PG_HOST = $(call unquote,$(or $(DB_POSTGRES_HOST),$(HOST)))
PG_PORT = $(call unquote,$(or $(DB_POSTGRES_PORT),$(PORT)))
PG_USER = $(call unquote,$(or $(DB_POSTGRES_USER),$(USER)))
PG_PASSWORD = $(call unquote,$(or $(DB_POSTGRES_PASSWORD),$(PASSWORD)))
DATABASE_URI = postgresql://$(PG_USER):$(PG_PASSWORD)@$(PG_HOST):$(PG_PORT)/$(DB_NAME)
MAINT_URI = postgresql://$(PG_USER):$(PG_PASSWORD)@$(PG_HOST):$(PG_PORT)/postgres

MONGO_URI = $(call unquote,$(DB_MONGO_URI))/$(call unquote,$(DB_MONGO_MESSENGER))

### - make {command}
### - make {command} TARGET={database}
### - make {command} TARGET={database} ENVIRONMENT={environment}

PSQL = psql "$(DATABASE_URI)" -f

create:
	psql "$(MAINT_URI)" -v ON_ERROR_STOP=1 -v DB=$(DB_NAME) -f db/create.sql

schema: ## Apply db/analytics/schema.sql to the analytics database (TARGET=analytics)
	@test "$(TARGET)" = "analytics" || { echo "schema: only TARGET=analytics; coredb and authdb are created by the Flyway of api-core and api-auth"; exit 1; }
	$(PSQL) db/analytics/schema.sql

# Seed planejado (empresas, unidades, catalogo, tecnicos, propostas). Ex.: make seed-plan ARGS=--dry-run
seed-plan: ## Run the planned seed (ARGS=--dry-run to preview)
	python -m seed $(ARGS)

reset: ## Drop and recreate the TARGET database empty (the Flyway of the API recreates the schema)
	psql "$(MAINT_URI)" -f db/reset.sql -v DB=$(DB_NAME)

reset-mongo: ## Reset the messenger MongoDB database
	mongosh "$(MONGO_URI)" db/messenger/reset.js

connect: ## Open psql on the TARGET database
	psql "$(DATABASE_URI)"

dataload: ## Load generated data (ROWS=1000)
	python -m scripts.dataload $(ROWS)

backup: ## Back up the PostgreSQL databases (TARGET=core|auth|all)
	$(POWERSHELL) -NoProfile -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1 -Target "$(if $(filter command line,$(origin TARGET)),$(TARGET),)"

export-parquet: ## Export the tables to Parquet for Databricks (TARGET=core|auth|all)
	python scripts/export_parquet.py --target "$(if $(filter command line,$(origin TARGET)),$(TARGET),)"

roles-apply: ## Create or refresh the read-only roles of the coredb consumers (ONLY=consumer)
	$(PY) scripts/roles.py apply $(if $(ONLY),--only $(ONLY),)

roles-check: ## Check the database against the read-only role contract (ONLY=consumer)
	$(PY) scripts/roles.py check $(if $(ONLY),--only $(ONLY),)

install-tools: ## Install PostgreSQL, Python and mongosh with winget (Windows)
	winget install --id PostgreSQL.PostgreSQL.16 -e
	winget install --id Python.Python.3.12 -e
	winget install --id MongoDB.Shell -e

# Stack local de desenvolvimento (Postgres, Redis, api-auth, api-core + seed). Ver scripts/dev-stack.sh.
dev-up: ## Start the local stack (Postgres, Redis, api-auth, api-core) and seed
	sh scripts/dev-stack.sh up

# So o banco: Postgres e Redis, migrations e seed, e mostra a string de conexao do coredb.
dev-db: ## Start only Postgres and Redis, migrate and seed
	sh scripts/dev-stack.sh db

dev-down: ## Stop the local stack
	sh scripts/dev-stack.sh down

dev-status: ## Show what is running in the local stack
	sh scripts/dev-stack.sh status

# Recarrega o seed; RESET=1 apaga antes o que o seed criou.
dev-seed: ## Reload the seed (RESET=1 clears what the seed created first)
	sh scripts/dev-stack.sh seed
